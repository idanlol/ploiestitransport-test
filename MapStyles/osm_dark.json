{
  "version": 8,
  "name": "OSM Pure Dark",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["https://tiles.openmaptiles.org/data/v3/{z}/{x}/{y}.pbf"]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#1e1e24" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#111b24" }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": { "line-color": "#2c2c35", "line-width": 1.5 }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": { "fill-color": "#25252b" }
    }
  ]
}
