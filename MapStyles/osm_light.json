{
  "version": 8,
  "name": "OSM Pure Light",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["https://demotiles.maplibre.org/tiles/{z}/{x}/{y}.pbf"]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f4f3f0" }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "geography",
      "paint": { "line-color": "#cadbf5", "line-width": 2 }
    }
  ]
}